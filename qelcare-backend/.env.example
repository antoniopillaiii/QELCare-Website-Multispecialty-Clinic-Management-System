# ============================================================================
# QELCare BACKEND environment  (qelcare-backend/.env)  — copy to `.env`
# ----------------------------------------------------------------------------
# cp .env.example .env  then fill in real values.  NEVER commit `.env`.
# Variable names below MUST match config/database.js (DB_USER / DB_PASS / ...).
# ============================================================================

# --- Server ---
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL ---
# These exact names are required by config/database.js.
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432
DB_NAME=

# --- JWT / tokens ---
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email (Brevo transactional API) ---
# The BACKEND is the only place email is sent from.
# IMPORTANT: BREVO_SENDER_EMAIL must be a VERIFIED sender (or verified domain)
# in the SAME Brevo account that owns BREVO_API_KEY, or every send is rejected.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=QELCare

# --- Email dev fallback ---
# true  -> if Brevo is unconfigured, OTP codes print to the SERVER CONSOLE so
#          local dev never gets stuck. (Recommended for development.)
# false -> force real email; a failed send rolls registration back with an error.
EMAIL_DEV_FALLBACK=true

# --- Cloudinary (profile pictures) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gemini (AI OCR insights) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- SMS (OTP + appointment notifications) ---
# Provider is pluggable. Leave as "console" (or unset) for a FREE, no-account
# setup: SMS is printed to the SERVER CONSOLE instead of sent (great for dev/demo).
#   console   -> print to server console only (no real delivery, always free)
#   textbelt  -> real send with NO account on the free public quota
#                (TEXTBELT_API_KEY=textbelt = 1 SMS/day), or self-host for free
#   semaphore -> Philippine gateway (free signup credits, no card) — SEMAPHORE_API_KEY
#   twilio    -> global gateway (trial credits) — TWILIO_* below
#
# PRODUCTION NOTE: on the deployed backend NODE_ENV=production, which turns the
# console fallback OFF (see SMS_DEV_FALLBACK below). So if NO provider is set in
# production, SMS OTP returns "SMS service is not configured. Use email instead."
# (by design — it will not silently pretend to send). To deliver real SMS in
# production, set SMS_PROVIDER + its key in your HOST's env (e.g. Railway → Variables),
# not this file. This .env is for LOCAL dev only and is gitignored.
#
# Appointment SMS is limited to key events (confirm/cancel/reschedule) to save
# credits — see SMS_STATUSES in features/appointment/controllers/appointmentController.js.
SMS_PROVIDER=console
# SMS_SENDER only applies to Semaphore, and it must be a sender name you have
# REGISTERED/approved in your Semaphore dashboard. Leave it UNSET to use
# Semaphore's default sender (works immediately on free/trial accounts).
# SMS_SENDER=QELCare
# true -> if the gateway is unconfigured OR a send fails, the code is logged to
#         the server console so dev/demo is never blocked. false -> real send only.
#         Auto-defaults to FALSE when NODE_ENV=production (i.e. on the live host).
SMS_DEV_FALLBACK=true
# TextBelt (free): "textbelt" = 1 SMS/day public quota; or your paid/self-host key.
TEXTBELT_API_KEY=textbelt
# TEXTBELT_URL=            # only for a self-hosted TextBelt server
# SEMAPHORE_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- Push notifications (Firebase Cloud Messaging, HTTP v1) ---
# From your Firebase service-account JSON (Project settings -> Service accounts ->
# Generate new private key). Leave blank to disable push (dev logs to console).
# IMPORTANT: keep the private key's \n escapes intact, wrapped in quotes, e.g.
#   FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
PUSH_DEV_FALLBACK=true
