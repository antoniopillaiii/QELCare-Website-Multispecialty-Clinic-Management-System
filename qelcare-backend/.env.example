# ============================================================================
# QELCare backend env — copy to .env and fill in. NEVER commit .env.
# Production values live in the host (Railway → Variables), not this file.
# ============================================================================

# --- Server ---
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL ---
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=5432
DB_NAME=

# --- JWT / tokens ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email (Brevo transactional API) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=QELCare
EMAIL_DEV_FALLBACK=true

# --- Cloudinary (profile pictures) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gemini (AI OCR) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- SMS (OTP + appointment alerts) — optional ---
# console = off (no send). Set a paid gateway to enable: semaphore / twilio / textbelt.
SMS_PROVIDER=console
# SEMAPHORE_API_KEY=

# --- Push notifications (Firebase Cloud Messaging) ---
# From the Firebase service-account JSON. Keep the private key's \n escapes.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
